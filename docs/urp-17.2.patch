+// Compensate the products and sums that cancel large affine translations.
+// No camera-specific state: UI, shadows and custom views use their own matrices.
+#if defined(STABLE_PROJECTION_ENABLED)
+float3 StableProjectionSplitHigh(float3 value)
+{
+    precise float3 scaled = value * 4097.0;
+    precise float3 high = scaled - (scaled - value);
+    return high;
+}
+
+float3 StableProjectionTwoSum(float3 a, float3 b, out float3 error)
+{
+    // Magnitude-order the operands for the FastTwoSum residual.
+    precise float3 large = abs(a) >= abs(b) ? a : b;
+    precise float3 small = abs(a) >= abs(b) ? b : a;
+    precise float3 sum = large + small;
+    precise float3 virtualSmall = sum - large;
+    precise float3 remainder = small - virtualSmall;
+    error = remainder;
+    return sum;
+}
+
+float3 StableProjectionProductError(float3 a, float3 b, float3 product)
+{
+    precise float3 aHigh = StableProjectionSplitHigh(a);
+    precise float3 bHigh = StableProjectionSplitHigh(b);
+    precise float3 aLow = a - aHigh;
+    precise float3 bLow = b - bHigh;
+    precise float3 error = ((aHigh * bHigh - product) + aHigh * bLow) + aLow * bHigh;
+    return error + aLow * bLow;
+}
