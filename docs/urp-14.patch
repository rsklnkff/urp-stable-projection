+// Compensate the products and sums that cancel large affine translations.
+// No camera-specific state: UI, shadows and custom views use their own matrices.
+#if defined(STABLE_PROJECTION_ENABLED)
+float3 StableProjectionSplitHigh(float3 value)
+{
+    precise float3 scaled = value * 4097.0;
+    precise float3 high = scaled - (scaled - value);
+    return high;
+}
+
+float3 StableProjectionTwoSum(float3 a, float3 b, out float3 error)
+{
+    // Magnitude-order the operands for the FastTwoSum residual.
+    precise float3 large = abs(a) >= abs(b) ? a : b;
+    precise float3 small = abs(a) >= abs(b) ? b : a;
+    precise float3 sum = large + small;
+    precise float3 virtualSmall = sum - large;
+    precise float3 remainder = small - virtualSmall;
+    error = remainder;
+    return sum;
+}
+
+float3 StableProjectionProductError(float3 a, float3 b, float3 product)
+{
+    precise float3 aHigh = StableProjectionSplitHigh(a);
+    precise float3 bHigh = StableProjectionSplitHigh(b);
+    precise float3 aLow = a - aHigh;
+    precise float3 bLow = b - bHigh;
+    precise float3 error = ((aHigh * bHigh - product) + aHigh * bLow) + aLow * bHigh;
+    return error + aLow * bLow;
+}
+
+float3 StableProjectionAffinePosition(float4x4 transform, float3 position)
+{
+    precise float3 a = transform._m00_m10_m20;
+    precise float3 b = transform._m01_m11_m21;
+    precise float3 c = transform._m02_m12_m22;
+    precise float3 x = a * position.x;
+    precise float3 y = b * position.y;
+    precise float3 z = c * position.z;
+    precise float3 error = StableProjectionProductError(a, position.xxx, x)
+        + StableProjectionProductError(b, position.yyy, y) + StableProjectionProductError(c, position.zzz, z);
+    float3 remainder;
+    precise float3 sum = StableProjectionTwoSum(transform._m03_m13_m23, x, remainder);
+    error += remainder;
+    sum = StableProjectionTwoSum(sum, y, remainder);
+    error += remainder;
+    sum = StableProjectionTwoSum(sum, z, remainder);
+    error += remainder;
+    return sum + error;
+}
+
+float3 StableProjectionObjectToView(float4 positionOS, float4x4 model, float4x4 view)
+{
+    precise float3x3 rotation = mul((float3x3)view, (float3x3)model);
+    precise float3 origin = StableProjectionAffinePosition(view, model._m03_m13_m23);
+    precise float3 positionVS = mul(rotation, positionOS.xyz) + origin * positionOS.w;
+    return positionVS;
